---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NK 2026 tickets - NAIS" active="Kalender" description="Het NK 2026 is geweest. De tickets en inschrijving zijn gesloten. Bekijk de uitslagen en de volgende evenementen van de Nederlandse Allround Inline Skate Bond.">
  <section data-theme="asphalt" style="background:var(--asphalt);color:var(--bone);padding:var(--space-9) var(--space-6);">
    <div style="max-width:var(--container);margin:0 auto;display:flex;flex-direction:column;gap:var(--space-5);">
      <a href="/kalender/2026-10-24-nk" class="nais-kicker" style="color:var(--concrete-300);text-decoration:none;">← NK 2026</a>
      <h1 style="font-family:var(--font-display);font-weight:400;font-size:var(--display-xl);line-height:0.9;letter-spacing:var(--tracking-display);color:var(--bone);margin:0;">Evenement afgesloten</h1>
      <span class="nais-kicker nais-accent">NK 2026 · 24 oktober · PARK Amsterdam</span>
    </div>
  </section>

  <section class="nais-section">
    <div style="max-width:800px;margin:0 auto;font-family:var(--font-sans);font-size:var(--text-base);line-height:1.65;color:var(--text);">
      <p>Het NK 2026 is geweest. Tickets en inschrijvingen zijn niet meer beschikbaar.</p>
      <p>Bekijk de <a href="/kalender/2026-10-24-nk" style="color:var(--accent-text);text-decoration:underline;">pagina van het NK 2026</a>, de <a href="/uitslagen" style="color:var(--accent-text);text-decoration:underline;">uitslagen</a> of de <a href="/kalender" style="color:var(--accent-text);text-decoration:underline;">kalender</a> voor de volgende evenementen.</p>
    </div>
  </section>
</Layout>
