---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Tag } from '../../components/nais/Tag.jsx';
import { RankBadge } from '../../components/nais/RankBadge.jsx';

export async function getStaticPaths() {
  const riders = await getCollection('deelnemers');
  return riders.map(rider => ({ params: { slug: rider.data.slug }, props: { rider } }));
}

const { rider } = Astro.props;

const uitslagenPosts = await getCollection('uitslagen');
const uitslagenData = await getCollection('uitslagenData');

type ResultEntry = {
  contestId: string;
  contestTitle: string;
  date: Date;
  unknownDate?: boolean;
  stage: string;
  category: string;
  rank: number;
  total: number;
  score?: number;
};

const results: ResultEntry[] = [];
for (const post of uitslagenPosts) {
  const dataEntry = uitslagenData.find(d => d.id === post.id);
  if (!dataEntry) continue;
  const stages = dataEntry.data as Record<string, Record<string, { id: number; score?: number }[]>>;
  for (const [stageName, categories] of Object.entries(stages)) {
    for (const [catName, participants] of Object.entries(categories)) {
      const idx = participants.findIndex(p => p.id === rider.data.id);
      if (idx === -1) continue;
      results.push({
        contestId: post.id,
        contestTitle: post.data.title,
        date: post.data.date,
        unknownDate: post.data.unknownDate,
        stage: stageName,
        category: catName,
        rank: idx + 1,
        total: participants.length,
        score: participants[idx].score,
      });
    }
  }
}
results.sort((a, b) => b.date.getTime() - a.date.getTime());

const displayName = rider.data.volledige_naam || rider.data.naam;
---

<Layout title={`${displayName} - Skaters - NAIS`} active="Skaters">

  {/* ── HERO ── */}
  <section class="nais-pagehead" data-theme="asphalt">
    <div class="nais-container">
      <div style="display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--concrete-400);margin-bottom:var(--space-5);">
        <a href="/skaters" style="color:var(--concrete-300);text-decoration:none;opacity:0.7;">Skaters</a>
        <span>/</span>
        <span style="color:var(--bone);opacity:0.6;">{rider.data.naam}</span>
      </div>

      <div style="display:flex;align-items:center;gap:var(--space-5);flex-wrap:wrap;">
        <div style="width:88px;height:88px;border-radius:50%;overflow:hidden;border:2px solid var(--asphalt-line);background:var(--asphalt-line);flex-shrink:0;">
          {rider.data.image && (
            <img src={rider.data.image} alt={displayName} style="width:100%;height:100%;object-fit:cover;display:block;" />
          )}
        </div>
        <div>
          <h1 style="font-family:var(--font-display);font-weight:400;font-size:var(--display-xl);line-height:0.9;letter-spacing:var(--tracking-display);color:var(--bone);margin:0 0 var(--space-3);text-transform:uppercase;">
            {displayName}
          </h1>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            {rider.data.categorie.map((c: string) => (
              <Tag tone="volt">{c}</Tag>
            ))}
            {rider.data.land ? (
              <span title={rider.data.land} style="font-size:20px;line-height:1;align-self:center;">
                {String.fromCodePoint(...[...rider.data.land].map((c: string) => 0x1f1e6 + c.charCodeAt(0) - 65))}
              </span>
            ) : (
              <a
                href={`mailto:info@naisbond.nl?subject=${encodeURIComponent(`Landcode ${displayName}`)}`}
                title="Landcode ontbreekt, mail ons om het aan te vullen"
                aria-label="Landcode ontbreekt, mail ons om het aan te vullen"
                style="display:inline-flex;align-items:center;gap:6px;align-self:center;font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--concrete-300);text-decoration:none;"
              >
                <span style="display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border:1.5px solid currentColor;border-radius:50%;font-size:11px;line-height:1;">?</span>
                <span style="font-weight:400;opacity:0.8;">Landcode ontbreekt, mail ons om het aan te vullen</span>
              </a>
            )}
            {rider.data.clubId != null && (
              <span title="Clublidnummer" style="font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:0.06em;color:var(--concrete-300);align-self:center;">
                {rider.data.clubId}
              </span>
            )}
          </div>
        </div>
      </div>

      {rider.data.bio && (
        <p style="font-family:var(--font-sans);font-size:var(--text-base);color:var(--concrete-300);max-width:60ch;margin:var(--space-5) 0 0;line-height:1.6;">
          {rider.data.bio}
        </p>
      )}

      {rider.data.socials && (rider.data.socials.instagram || rider.data.socials.website) && (
        <div style="display:flex;gap:var(--space-4);margin-top:var(--space-5);">
          {rider.data.socials.instagram && (
            <a href={rider.data.socials.instagram} target="_blank" rel="noopener noreferrer" style="font-family:var(--font-mono);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--accent-text);text-decoration:none;">
              Instagram →
            </a>
          )}
          {rider.data.socials.website && (
            <a href={rider.data.socials.website} target="_blank" rel="noopener noreferrer" style="font-family:var(--font-mono);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--accent-text);text-decoration:none;">
              Website →
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  {/* ── RESULTS HISTORY ── */}
  <section class="nais-section">
    <div class="nais-container">
      <h2 style="font-family:var(--font-display);font-weight:400;font-size:var(--display-lg);line-height:var(--leading-tight);letter-spacing:var(--tracking-display);margin:0 0 var(--space-7);text-transform:uppercase;">
        {results.length > 0 ? `${results.length} resultaten` : 'Nog geen resultaten'}
      </h2>

      {results.length === 0 ? (
        <p style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);">
          Er zijn nog geen geregistreerde uitslagen voor deze skater.
        </p>
      ) : (
        <div style="display:flex;flex-direction:column;gap:var(--space-4);">
          {results.map(r => (
            <a
              href={`/uitslagen/${r.contestId}`}
              style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-6);padding:var(--space-5) var(--space-6);border:var(--border-bold) solid var(--border-strong);border-radius:var(--radius-sm);background:var(--bg-elevated);text-decoration:none;color:var(--text);flex-wrap:wrap;"
            >
              <div style="display:flex;flex-direction:column;gap:var(--space-2);min-width:0;">
                {!r.unknownDate && (
                  <span class="nais-kicker" style="color:var(--text-muted);">
                    {r.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </span>
                )}
                <h3 style="font-family:var(--font-display);font-weight:400;font-size:var(--display-sm);line-height:0.95;letter-spacing:var(--tracking-display);margin:0;text-transform:uppercase;">
                  {r.contestTitle}
                </h3>
                <span style="font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--text-muted);">
                  {r.stage} · {r.category}
                </span>
              </div>
              <div style="display:flex;align-items:center;gap:var(--space-3);flex-shrink:0;">
                {r.score != null && (
                  <span style="font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--text-muted);">
                    {r.score} pt
                  </span>
                )}
                {r.rank <= 3
                  ? <RankBadge rank={r.rank} size="lg" />
                  : <span style="font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--text-faint);min-width:38px;text-align:center;">#{r.rank}</span>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>
