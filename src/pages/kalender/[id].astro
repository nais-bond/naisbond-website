---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { EventCard } from '../../components/nais/EventCard.jsx';
import { getLatestReglement } from '../../lib/reglementen';

export async function getStaticPaths() {
  const posts = await getCollection('calendar');
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const imageSrc = typeof post.data.image === 'string' ? post.data.image : post.data.image?.src ?? '';

const dateStr = post.data.dateLabel ?? post.data.date.toLocaleDateString('nl-NL', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
const timeStr = !post.data.dateLabel && post.data.fromDate
  ? post.data.fromDate.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' })
  : null;

const metaTags = ['Contest', 'Demo', 'uitgelicht', 'Uitgelicht'];
const city = post.data.tags.find((t: string) => !metaTags.includes(t)) ?? null;
const categoryTags = post.data.tags.filter((t: string) => t.toLowerCase() !== 'uitgelicht');
const reglement = post.data.reglement ? await getLatestReglement(post.data.reglement) : undefined;

// Related events: same collection, exclude self, prefer tag overlap, max 3
const allPosts = await getCollection('calendar');
const related = allPosts
  .filter(p => !p.data.draft && p.id !== post.id)
  .sort((a, b) => {
    const scoreA = a.data.tags.filter((t: string) => post.data.tags.includes(t)).length;
    const scoreB = b.data.tags.filter((t: string) => post.data.tags.includes(t)).length;
    if (scoreB !== scoreA) return scoreB - scoreA;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 3);
---

<Layout title={`${post.data.title} - NAIS`} active="Kalender" description={post.data.description ?? `${post.data.title}, ${dateStr}${city ? ` in ${city}` : ''}. Meer info op de NAIS kalender.`} image={imageSrc || undefined} type="article">

  {/* ── EVENT HERO ── */}
  <section
    data-theme="asphalt"
    style="position:relative;min-height:520px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;background:var(--asphalt);"
  >
    {imageSrc && (
      <img
        src={imageSrc}
        alt=""
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:0.65;filter:contrast(1.05) saturate(0.8);"
      />
    )}
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(19,19,18,.1) 0%,rgba(19,19,18,.25) 35%,rgba(19,19,18,.92) 100%);"></div>

    <div style="position:relative;max-width:var(--container);margin:0 auto;width:100%;padding:0 var(--space-6) var(--space-8);">
      {/* Breadcrumb */}
      <div style="display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--concrete-400);margin-bottom:var(--space-5);">
        <a href="/kalender" style="color:var(--concrete-300);text-decoration:none;opacity:0.7;">Kalender</a>
        <span>/</span>
        <span style="color:var(--bone);opacity:0.6;">{post.data.title}</span>
      </div>

      {/* Tags row */}
      {categoryTags.length > 0 && (
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin-bottom:var(--space-5);">
          {categoryTags.map((tag: string) => (
            <span style="display:inline-flex;align-items:center;padding:4px 10px;font-family:var(--font-mono);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;border:1px solid rgba(255,255,255,0.25);border-radius:var(--radius-pill);color:var(--concrete-200);background:rgba(19,19,18,0.4);">
              {tag}
            </span>
          ))}
        </div>
      )}

      {/* Title */}
      <h1 style="font-family:var(--font-display);font-weight:400;font-size:clamp(34px,4.8vw,64px);line-height:0.92;letter-spacing:var(--tracking-display);color:var(--bone);margin:0 0 var(--space-5);max-width:22ch;">
        {post.data.title}
      </h1>

      {/* Kicker meta */}
      <div style="display:flex;flex-wrap:wrap;gap:var(--space-5);align-items:center;">
        <span class="nais-kicker nais-accent">{dateStr}{timeStr ? ` · ${timeStr}` : ''}</span>
        {city && <span class="nais-kicker" style="color:var(--concrete-300);">{city}</span>}
      </div>
    </div>

    <div style="position:relative;width:100%;height:8px;border-top:var(--border-hair) solid rgba(255,255,255,0.1);"></div>
  </section>

  {/* ── EVENT BODY ── */}
  <section class="nais-section">
    <div class="event-body-grid">

      {/* Left: markdown content */}
      <div class="event-prose">
        <Content />
      </div>

      {/* Right: sticky sidebar */}
      <aside style="position:sticky;top:var(--space-6);display:flex;flex-direction:column;gap:var(--space-5);">

        {/* Event details card */}
        <div style="border:var(--border-bold) solid var(--border-strong);border-radius:var(--radius-sm);overflow:hidden;">
          <div data-theme="asphalt" style="background:var(--asphalt);padding:var(--space-5);">
            {post.data.description && (
              <p style="font-family:var(--font-sans);font-size:var(--text-sm);color:var(--concrete-200);margin:0;line-height:1.5;">{post.data.description}</p>
            )}
          </div>
          <div style="background:var(--bg-elevated);padding:var(--space-5);display:flex;flex-direction:column;gap:var(--space-4);">
            <div>
              <span class="nais-kicker nais-label-block">Datum</span>
              <span style="font-family:var(--font-sans);font-size:var(--text-sm);color:var(--text);font-weight:600;">{dateStr}</span>
            </div>
            {city && (
              <div>
                <span class="nais-kicker nais-label-block">Locatie</span>
                <span style="font-family:var(--font-sans);font-size:var(--text-sm);color:var(--text);font-weight:600;">{city}</span>
              </div>
            )}
            {categoryTags.length > 0 && (
              <div>
                <span class="nais-kicker nais-label-block">Categorie</span>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
                  {categoryTags.slice(0, 3).map((t: string) => (
                    <span style="padding:3px 8px;font-family:var(--font-mono);font-size:11px;border:1px solid var(--border);border-radius:var(--radius-pill);color:var(--text-muted);">{t}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        {/* Reglement card */}
        {reglement && (
          <a
            href={`/reglementen/${reglement.data.reglement}`}
            style="display:flex;flex-direction:column;gap:6px;padding:var(--space-5);border:var(--border-bold) solid var(--volt);border-radius:var(--radius-sm);background:var(--bg-elevated);text-decoration:none;"
          >
            <span class="nais-kicker nais-accent">Reglement · v{reglement.data.version}</span>
            <span style="font-family:var(--font-sans);font-size:var(--text-sm);color:var(--text);font-weight:600;line-height:1.4;">{reglement.data.title}</span>
            <span style="font-family:var(--font-sans);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--accent-text);">Lees het reglement →</span>
          </a>
        )}

        {/* Back link */}
        <a
          href="/kalender"
          style="display:inline-flex;align-items:center;gap:8px;font-family:var(--font-sans);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:0.04em;padding:10px 16px;background:transparent;color:var(--text-muted);border:var(--border-bold) solid var(--border);border-radius:var(--radius-sm);text-decoration:none;"
        >
          ← Terug naar kalender
        </a>
      </aside>
    </div>
  </section>

  {/* ── MORE EVENTS ── */}
  {related.length > 0 && (
    <section style="background:var(--bg);border-top:var(--border-hair) solid var(--border);padding:var(--space-8) var(--space-6);">
      <div class="nais-container">
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-4);margin-bottom:var(--space-7);">
          <div>
            <h2 style="font-family:var(--font-display);font-weight:400;font-size:var(--display-md);line-height:0.95;letter-spacing:var(--tracking-display);margin:0;">Meer events</h2>
          </div>
          <a href="/kalender" style="font-family:var(--font-sans);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:0.04em;color:var(--accent-text);text-decoration:none;">Alle events →</a>
        </div>
        <div class="event-related-grid">
          {related.map(e => {
            const img = typeof e.data.image === 'string' ? e.data.image : e.data.image?.src ?? '';
            const eDateStr = e.data.dateLabel ?? e.data.date.toLocaleDateString('nl-NL', { day: '2-digit', month: '2-digit', year: '2-digit' }).replace(/\//g, '.');
            const eCity = e.data.tags.find((t: string) => !metaTags.includes(t)) ?? '';
            const eTags = e.data.tags.filter((t: string) => t.toLowerCase() !== 'uitgelicht').slice(0, 3);
            return (
              <EventCard
                image={img}
                title={e.data.title}
                date={eDateStr}
                city={eCity}
                tags={eTags}
                href={`/kalender/${e.id}`}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

</Layout>

<style is:global>
  .event-body-grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-8);
    align-items: start;
  }
  .event-body-grid > * { min-width: 0; }
  .event-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  @media (max-width: 700px) {
    .event-body-grid {
      grid-template-columns: 1fr;
    }
    .event-body-grid aside {
      position: static;
    }
    .event-related-grid {
      grid-template-columns: 1fr;
    }
  }
  .event-prose {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--text);
  }
  .event-prose h1,
  .event-prose h2,
  .event-prose h3 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    margin: var(--space-6) 0 var(--space-3);
    color: var(--text);
  }
  .event-prose h1 { font-size: var(--prose-h1); }
  .event-prose h2 { font-size: var(--prose-h2); }
  .event-prose h3 { font-size: var(--prose-h3); font-family: var(--font-sans); font-weight: 700; }
  .event-prose p { margin: 0 0 var(--space-4); }
  .event-prose ul, .event-prose ol { padding-left: var(--space-5); margin: 0 0 var(--space-4); }
  .event-prose li { margin-bottom: var(--space-2); }
  .event-prose a { color: var(--accent-text); text-decoration: underline; }
  .event-prose strong { font-weight: 700; color: var(--text); }
  .event-prose img {
    width: 100%;
    border-radius: var(--radius-sm);
    margin: var(--space-6) 0;
  }
  .event-prose iframe {
    width: 100%;
    max-width: 100%;
  }
  .event-prose blockquote.instagram-media {
    min-width: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    overflow: hidden;
  }
  .event-prose blockquote.instagram-media iframe {
    max-width: 100% !important;
    width: 100% !important;
  }
  .event-prose table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 13px;
    margin: var(--space-5) 0;
  }
  .event-prose th {
    text-align: left;
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--border-bold) solid var(--border-strong);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
    color: var(--text-muted);
  }
  .event-prose td {
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-hair) solid var(--border);
    color: var(--text);
    vertical-align: top;
  }
  .event-prose tr:last-child td { border-bottom: none; }
  .event-prose hr {
    border: none;
    border-top: var(--border-hair) solid var(--border);
    margin: var(--space-7) 0;
  }
</style>
