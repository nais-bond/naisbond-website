---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { UitslagenView } from '../../components/UitslagenView.jsx';
import { Image } from 'astro:assets';
import nkImg from '../../assets/images/events/nk-2025-park.jpg';
import nk2026Img from '../../assets/images/events/nk-2026-header.jpg';

const headerImages: Record<string, ImageMetadata> = { 'nk-2026': nk2026Img, 'nk-2026-kwalificatie': nk2026Img };

export async function getStaticPaths() {
  const posts = await getCollection('uitslagen');
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const headerImg = headerImages[post.id] ?? nkImg;
const { Content } = await render(post);

// Load JSON data
const dataEntry = await getEntry('uitslagenData', post.id);
if (!dataEntry) throw new Error('uitslagenData not found: ' + post.id);

// Load deelnemers for name lookup
const deelnemers = await getCollection('deelnemers');

// Merge: resolve ids → names per stage/category
const stages: Record<string, Record<string, { rank: number; naam: string; volledige_naam?: string; land?: string; score?: number; prize?: number; slug?: string }[]>> = {};
for (const [stageName, categories] of Object.entries(dataEntry.data as Record<string, Record<string, { id: number; score?: number; prize?: number }[]>>)) {
  stages[stageName] = {};
  for (const [catName, participants] of Object.entries(categories)) {
    stages[stageName][catName] = participants.map((p) => {
      const d = deelnemers.find((dd) => dd.data.id === p.id);
      return {
        naam: d?.data.naam ?? 'Onbekend',
        volledige_naam: d?.data.volledige_naam,
        land: d?.data.land,
        score: p.score,
        prize: p.prize,
        slug: d?.data.slug,
      };
    });
  }
}

const dateStr = post.data.date.toLocaleDateString('nl-NL', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Layout title={`${post.data.title} - Uitslagen - NAIS`} active="Uitslagen">

  {/* ── HERO ── */}
  <section
    data-theme="asphalt"
    style="position:relative;min-height:420px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;background:var(--asphalt);"
  >
    <Image
      src={headerImg}
      alt=""
      widths={[640, 1024, 1600]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;opacity:0.5;filter:contrast(1.1) saturate(0.7);"
    />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(19,19,18,.15) 0%,rgba(19,19,18,.88) 100%);"></div>

    <div style="position:relative;max-width:var(--container);margin:0 auto;width:100%;padding:0 var(--space-6) var(--space-8);">
      <div style="display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--concrete-400);margin-bottom:var(--space-5);">
        <a href="/uitslagen" style="color:var(--concrete-300);text-decoration:none;opacity:0.7;">Uitslagen</a>
        <span>/</span>
        <span style="color:var(--bone);opacity:0.6;">{post.data.title}</span>
      </div>

      <span style="display:inline-flex;align-items:center;padding:4px 10px;font-family:var(--font-mono);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;border:1px solid rgba(255,255,255,0.25);border-radius:var(--radius-pill);color:var(--accent-text);background:rgba(19,19,18,0.4);margin-bottom:var(--space-5);">
        Officiële uitslag
      </span>

      <h1 style="font-family:var(--font-display);font-weight:400;font-size:clamp(34px,4.8vw,64px);line-height:0.92;letter-spacing:var(--tracking-display);color:var(--bone);margin:0 0 var(--space-5);max-width:22ch;">
        {post.data.title}
      </h1>

      {!post.data.unknownDate && (
        <span class="nais-kicker nais-accent">{dateStr}</span>
      )}
    </div>

    <div style="position:relative;width:100%;height:8px;border-top:var(--border-hair) solid rgba(255,255,255,0.1);"></div>
  </section>

  {/* ── RESULTS BODY ── */}
  <section class="nais-section">
    <div class="uitslag-body-grid">

      {/* Left: alle uitslagen onder elkaar met anchor-links */}
      <div>
        {post.data.description && (
          <p style="font-family:var(--font-sans);font-size:var(--text-base);color:var(--text-muted);margin:0 0 var(--space-7);line-height:1.6;">
            <Content />
          </p>
        )}
        <UitslagenView stages={stages} client:load />
      </div>

      {/* Right: sticky meta sidebar */}
      <aside style="position:sticky;top:var(--space-6);display:flex;flex-direction:column;gap:var(--space-5);">
        <div style="border:var(--border-bold) solid var(--border-strong);border-radius:var(--radius-sm);overflow:hidden;">
          <div data-theme="asphalt" style="background:var(--asphalt);padding:var(--space-5);">
            <p style="font-family:var(--font-display);font-weight:400;font-size:var(--display-sm);line-height:0.95;letter-spacing:var(--tracking-display);color:var(--bone);margin:0;text-transform:uppercase;">
              {post.data.title}
            </p>
          </div>
          <div style="background:var(--bg-elevated);padding:var(--space-5);display:flex;flex-direction:column;gap:var(--space-4);">
            {!post.data.unknownDate && (
              <div>
                <span class="nais-kicker nais-label-block">Datum</span>
                <span style="font-family:var(--font-sans);font-size:var(--text-sm);color:var(--text);font-weight:600;">{dateStr}</span>
              </div>
            )}
            {post.data.author && (
              <div>
                <span class="nais-kicker nais-label-block">Bijdrage</span>
                <span style="font-family:var(--font-sans);font-size:var(--text-sm);color:var(--text);font-weight:600;">{post.data.author}</span>
              </div>
            )}
            {(() => {
              const cats = [...new Set(Object.values(stages).flatMap(s => Object.keys(s)))];
              return cats.length > 0 && (
                <div>
                  <span class="nais-kicker" style="color:var(--text-muted);display:block;margin-bottom:6px;">Categorieën</span>
                  <div style="display:flex;flex-direction:column;gap:4px;">
                    {cats.map(cat => (
                      <span style="font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--text-muted);">{cat}</span>
                    ))}
                  </div>
                </div>
              );
            })()}
          </div>
        </div>

        <a
          href="/uitslagen"
          style="display:inline-flex;align-items:center;gap:8px;font-family:var(--font-sans);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:0.04em;padding:10px 16px;background:transparent;color:var(--text-muted);border:var(--border-bold) solid var(--border);border-radius:var(--radius-sm);text-decoration:none;"
        >
          ← Alle uitslagen
        </a>
      </aside>
    </div>
  </section>

</Layout>

<style>
  .uitslag-body-grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-8);
    align-items: start;
  }
  .uitslag-body-grid > * { min-width: 0; }
  @media (max-width: 700px) {
    .uitslag-body-grid {
      grid-template-columns: 1fr;
    }
    .uitslag-body-grid aside {
      position: static;
    }
  }
</style>
