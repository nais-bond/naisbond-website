---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRanking, rankingYears, POINTS, NK_WINNER_MULTIPLIER } from '../lib/ranking';
import { RankBadge } from './nais/RankBadge.jsx';
import { CountryCode } from './nais/CountryCode.jsx';

interface Props { year?: number }
const currentYear = new Date().getFullYear();
const { year = currentYear } = Astro.props;
const ranking = await getRanking(year);
const years = rankingYears();
const deelnemers = await getCollection('deelnemers');
const byId = new Map(deelnemers.map((d) => [d.data.id, d.data]));

const sections = [
  { key: 'Junioren', anchor: 'junioren', title: 'Junioren' },
  { key: 'Vrouwen', anchor: 'vrouwen', title: 'Vrouwen' },
  { key: 'Mannen', anchor: 'mannen', title: 'Mannen' },
] as const;
---

<Layout title={`Ranking ${year} (BETA) - NAIS`} active="Uitslagen" description={`Beta-ranking van Nederlandse aggressive inline skaters op basis van uitslagen van ${year}.`}>

  <section class="nais-pagehead" data-theme="asphalt">
    <div class="nais-container">
      <span class="nais-kicker nais-accent nais-eyebrow-block">Uitslagen</span>
      <div style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-5);">
        <h1 style="font-family:var(--font-display);font-weight:400;font-size:var(--display-xl);line-height:0.9;letter-spacing:var(--tracking-display);color:var(--bone);margin:0;">Ranking</h1>
        <span class="beta-tag">BETA</span>
      </div>
      <nav class="year-nav" aria-label="Kies jaar">
        {years.map((y) => <a href={y === currentYear ? '/ranking' : `/ranking/${y}`} aria-current={y === year ? 'page' : undefined}>{y}</a>)}
      </nav>
    </div>
  </section>

  <section class="nais-section">
    <div class="nais-container">
      <div class="beta-note">
        <strong>Dit is een beta.</strong> We zijn nog bezig met een goed rankingsysteem. Punten en berekening kunnen nog wijzigen.
        <p style="margin:var(--space-3) 0 0;">
          Elke finale-uitslag van {year} levert punten op:
          {POINTS.map((p, i) => `${i + 1}e ${p}`).slice(0, -1).join(' · ')} · 8e en lager {POINTS[POINTS.length - 1]}.
          De 1e plaats op een NK is {NK_WINNER_MULTIPLIER}× zoveel waard. Voorrondes en kwalificaties tellen niet mee.
        </p>
      </div>

      <nav class="anchor-nav" aria-label="Spring naar categorie">
        {sections.map((s) => <a href={`#${s.anchor}`}>{s.title}</a>)}
      </nav>

      {sections.map((s) => (
        <section id={s.anchor} class="rank-section">
          <h2 class="rank-h2">
            {s.title}
            <a href={`#${s.anchor}`} class="rank-anchor" aria-label={`Link naar ${s.title}`}>#</a>
          </h2>
          {ranking[s.key].length === 0 ? (
            <p style="color:var(--text-muted);">Nog geen uitslagen in deze categorie.</p>
          ) : (
            <ol class="rank-list">
              {ranking[s.key].map((r) => {
                const d = byId.get(r.id);
                return (
                  <li class="rank-row">
                    <details>
                      <summary>
                        <span class="rank-pos"><RankBadge rank={r.rank} client:load /></span>
                        <span class="rank-name">
                          {d?.slug ? <a href={`/skaters/${d.slug}`}>{d.volledige_naam ?? d.naam}</a> : (d?.naam ?? 'Onbekend')}
                          <CountryCode code={d?.land} style={{ marginLeft: '8px' }} client:load />
                        </span>
                        <span class="rank-pts">{r.total}<small> pnt</small></span>
                      </summary>
                      <ul class="rank-breakdown">
                        {r.entries.map((e) => (
                          <li>
                            <a href={`/uitslagen/${e.contestId}`}>{e.contest}</a>
                            <span>{e.place}e plaats</span>
                            <span>+{e.points}</span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                );
              })}
            </ol>
          )}
        </section>
      ))}
    </div>
  </section>

</Layout>

<style>
  .year-nav { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .year-nav a { font-family: var(--font-sans); font-weight: 700; font-size: 13px; letter-spacing: 0.04em; padding: 8px 16px; border: var(--border-bold) solid var(--concrete-300); border-radius: var(--radius-pill); color: var(--bone); text-decoration: none; }
  .year-nav a:hover, .year-nav a[aria-current] { background: var(--volt); color: var(--volt-ink); border-color: var(--volt); }
  .beta-tag { font-family: var(--font-display); font-size: clamp(28px, 4vw, 48px); line-height: 1; padding: 6px 16px; background: var(--volt); color: var(--volt-ink); border-radius: var(--radius-sm); letter-spacing: 0.06em; transform: rotate(-3deg); }
  .beta-note { border: var(--border-bold) solid var(--volt); border-radius: var(--radius-sm); padding: var(--space-5); background: var(--bg-elevated); line-height: 1.6; margin-bottom: var(--space-6); }
  .anchor-nav { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-8); }
  .anchor-nav a { font-family: var(--font-sans); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; padding: 10px 16px; border: var(--border-bold) solid var(--border-strong); border-radius: var(--radius-pill); color: var(--text); text-decoration: none; }
  .anchor-nav a:hover { background: var(--volt); color: var(--volt-ink); border-color: var(--volt); }
  .rank-section { scroll-margin-top: 90px; margin-bottom: var(--space-9); }
  .rank-h2 { font-family: var(--font-display); font-weight: 400; font-size: var(--display-md); line-height: 0.95; letter-spacing: var(--tracking-display); text-transform: uppercase; margin: 0 0 var(--space-5); }
  .rank-anchor { margin-left: 12px; font-size: 0.6em; color: var(--text-muted); text-decoration: none; opacity: 0; }
  .rank-h2:hover .rank-anchor, .rank-anchor:focus { opacity: 1; }
  .rank-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .rank-row { border: var(--border-bold) solid var(--border); border-radius: var(--radius-sm); background: var(--bg-elevated); }
  .rank-row summary { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); cursor: pointer; list-style: none; }
  .rank-row summary::-webkit-details-marker { display: none; }
  .rank-pos { width: 44px; flex-shrink: 0; }
  .rank-name { flex: 1; min-width: 0; font-family: var(--font-sans); font-weight: 700; }
  .rank-name a { color: var(--text); text-decoration: none; }
  .rank-name a:hover { text-decoration: underline; }
  .rank-pts { font-family: var(--font-mono); font-weight: 700; font-size: 18px; }
  .rank-pts small { font-size: 11px; color: var(--text-muted); }
  .rank-breakdown { list-style: none; margin: 0; padding: 0 var(--space-4) var(--space-3) calc(44px + var(--space-8)); font-size: var(--text-sm); color: var(--text-muted); }
  .rank-breakdown li { display: grid; grid-template-columns: 1fr auto auto; gap: var(--space-4); padding: 4px 0; }
  .rank-breakdown a { color: var(--text-muted); }
  @media (max-width: 700px) { .rank-breakdown { padding-left: var(--space-4); } }
</style>
